{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moments-in-light",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // 매일 03:00 KST(18:00 UTC): 만료 세션·오래된 로그인 시도 정리 + 보관기한 지난 휴지통 영구삭제
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  // 배포 버전 id를 HTML의 style.css·app.js 주소에 붙여, 캐시가 옛 파일을 붙잡지 못하게 합니다.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pht_pp",
      "database_id": "69084f63-8997-47e4-8882-630b453bfd6f",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "pht-pp-photos"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "pht-pp-backups"
    }
  ]
  // ADMIN_PASSWORD: 로컬은 .dev.vars, 프로덕션은 `wrangler secret put ADMIN_PASSWORD`

}
