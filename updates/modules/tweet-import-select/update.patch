diff --git a/test/tweet-import.node.mjs b/test/tweet-import.node.mjs
new file mode 100644
--- /dev/null
+++ b/test/tweet-import.node.mjs
@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { runInNewContext } from 'node:vm'
+import { test } from 'node:test'
+
+const source = readFileSync(new URL('../public/admin.js', import.meta.url), 'utf8')
+const functions = source.slice(source.indexOf('function parseTweetInfo('), source.indexOf('// ---------- client-side resize'))
+const template = '원신 - 감우\nModel::라기짱 님 (@ragi)'
+function setup({ choice = { selected: { account: true, series: true, character: true } }, failSave = false, text = template } = {}) {
+  const calls = [], status = { textContent: '', dataset: {} }
+  const context = {
+    api: async (path, opts) => {
+      calls.push([path, opts])
+      if (path.startsWith('/tweet-media')) return { photos: [{ url: 'image' }], text }
+      if (path === '/model-names' && failSave) throw new Error('이름 저장 실패')
+      return { id: 42 }
+    },
+    fetch: async (url) => { calls.push(['fetch', url]); return { ok: true, blob: async () => ({ type: 'image/jpeg' }) } },
+    File: class {},
+    uploadOne: async (...args) => { calls.push(['upload', ...args]) },
+    renderCollection: async () => { calls.push(['render']) },
+    document: { querySelector: () => null },
+  }
+  const fn = runInNewContext(`${functions}\nchooseTweetImport = async () => choice;\n({ parseTweetInfo, tweetImportFields, importTweet, applyTweetImport })`, { ...context, choice })
+  const group = { id: 7, name: '기존 폴더', meta: { twitter: ['old'] }, series: ['기존 작품'] }
+  return { ...fn, calls, status, group, col: { groups: [group] } }
+}
+const plain = (v) => JSON.parse(JSON.stringify(v))
+test('parses nickname, account, series and character separately', () => {
+  const x = setup()
+  for (const name of ['라기짱 님', '라기짱님', '라기짱']) {
+    const info = x.parseTweetInfo(`승리의 여신 : 니케 - 크러스트\nModel::${name} (@ragi)`)
+    assert.deepEqual(plain(info), { models: [{ name: '라기짱', handle: 'ragi' }], series: '승리의 여신: 니케', character: '크러스트' })
+  }
+})
+test('only account, series and character are checked by default', () => {
+  const x = setup(), fields = x.tweetImportFields(x.parseTweetInfo(template), [{ url: 'a' }])
+  assert.deepEqual(plain(fields.filter((f) => f.checked).map((f) => f.key)), ['account', 'series', 'character'])
+  assert.equal(x.tweetImportFields(x.parseTweetInfo(''), []).filter((f) => f.value).length, 0)
+})
+test('default selection saves metadata without nickname or photos', async () => {
+  const x = setup()
+  await x.importTweet(1, 7, 'tweet', x.status, x.col)
+  assert.deepEqual(plain(x.calls.find(([p]) => p === '/groups/7')[1].json), { twitter: 'ragi', series: ['원신'], character: '감우' })
+  assert.ok(!x.calls.some(([p]) => ['upload', 'fetch', '/model-names'].includes(p)))
+  assert.equal(x.status.dataset.tweetBusy, undefined)
+})
+test('cancel performs no writes or image transfers', async () => {
+  const x = setup({ choice: null })
+  await x.importTweet(1, 7, 'tweet', x.status, x.col)
+  assert.equal(x.calls.filter(([, opts]) => opts?.method).length, 0)
+  assert.ok(!x.calls.some(([p]) => ['upload', 'fetch', 'render'].includes(p)))
+})
+test('character-only preserves existing derived series and account', async () => {
+  const x = setup({ choice: { selected: { character: true } } })
