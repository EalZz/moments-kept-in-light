+import { describe, expect, it, vi } from 'vitest'
+import { env, SELF } from 'cloudflare:test'
+import worker from '../src/worker.js'
+
+async function login(password = 'test-password') {
+  const response = await SELF.fetch('https://example.com/api/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ password }),
+  })
+  return { response, cookie: response.headers.get('set-cookie')?.split(';')[0] }
+}
+
+async function seedCollection({ title, published = 1, deletedAt = null, shootType = 'event', locationType = '', relatedEventId = null } = {}) {
+  const result = await env.DB.prepare(
+    `INSERT INTO collections
+       (title, description, published, deleted_at, shoot_type, location_type, related_event_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  ).bind(title || 'Collection', 'Description', published, deletedAt, shootType, locationType, relatedEventId).run()
+  return result.meta.last_row_id
+}
+
+// 선택하지 않은 작품이 캐릭터명에서 새로 유도되지 않게 빈 배열을 보존합니다.
+describe('tweet import independent fields', () => {
+  it('preserves explicit no-series when importing only character', async () => {
+    const collectionId = await seedCollection()
+    const { meta } = await env.DB.prepare("INSERT INTO groups (collection_id, name) VALUES (?, '기존 이름')").bind(collectionId).run()
+    const { cookie } = await login()
+    const response = await SELF.fetch(`https://example.com/api/groups/${meta.last_row_id}`, {
+      method: 'PATCH', headers: { cookie, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ character: '감우', series: [] }),
+    })
+    expect(response.status).toBe(200)
+    const detail = await SELF.fetch(`https://example.com/api/collections/${collectionId}`, { headers: { cookie } })
+    const group = (await detail.json()).groups[0]
+    expect(group.name).toBe('기존 이름')
+    expect(group.meta.character).toBe('감우')
+    expect(group.meta.series).toEqual([])
+    expect(group.series).toEqual([])
+  })
+})
+
+
+describe('tweet metadata without photos', () => {
+  it('returns text instead of rejecting a text-only tweet', async () => {
+    const { cookie } = await login()
+    const upstream = vi.spyOn(globalThis, 'fetch').mockResolvedValue(Response.json({
+      tweet: { text: '원신 - 감우\nModel::라기짱 (@ragi)' },
+    }))
+    try {
+      const request = new Request('https://example.com/api/tweet-media?url=https://x.com/example/status/1234567890', { headers: { cookie } })
+      const response = await worker.fetch(request, env, {})
+      expect(response.status).toBe(200)
+      expect(await response.json()).toEqual({ photos: [], text: '원신 - 감우\nModel::라기짱 (@ragi)' })
+      expect(upstream).toHaveBeenCalledWith('https://api.fxtwitter.com/status/1234567890', expect.any(Object))
+    } finally {
+      upstream.mockRestore()
+    }
+  })
+})
