diff --git a/test/personal-session-cards.worker.test.js b/test/personal-session-cards.worker.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..15d4adea48e92829021ebef830fb6c61b4d15581
--- /dev/null
+++ b/test/personal-session-cards.worker.test.js
@@ -0,0 +1,64 @@
+import { describe, expect, it } from 'vitest'
+import { env, SELF } from 'cloudflare:test'
+
+async function login(password = 'test-password') {
+  const response = await SELF.fetch('https://example.com/api/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ password }),
+  })
+  return { response, cookie: response.headers.get('set-cookie')?.split(';')[0] }
+}
+
+async function seedCollection({ title, published = 1, deletedAt = null, shootType = 'event', locationType = '', relatedEventId = null } = {}) {
+  const result = await env.DB.prepare(
+    `INSERT INTO collections
+       (title, description, published, deleted_at, shoot_type, location_type, related_event_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  ).bind(title || 'Collection', 'Description', published, deletedAt, shootType, locationType, relatedEventId).run()
+  return result.meta.last_row_id
+}
+
+describe('personal-session-cards', () => {
+  it('persists a manual card crop for the active session cover only', async () => {
+    const id = await seedCollection({ shootType: 'session' })
+    const first = await env.DB.prepare(
+      'INSERT INTO photos (collection_id, key_large, key_thumb, width, height) VALUES (?, ?, ?, 600, 900)'
+    ).bind(id, 'crop-l', 'crop-t').run()
+    const second = await env.DB.prepare(
+      'INSERT INTO photos (collection_id, key_large, key_thumb) VALUES (?, ?, ?)'
+    ).bind(id, 'next-l', 'next-t').run()
+    const photoId = first.meta.last_row_id
+    const base = `https://example.com/api/collections/${id}`
+    const { cookie } = await login()
+    const patch = (url, data, auth = cookie) => SELF.fetch(url, {
+      method: 'PATCH',
+      headers: { Cookie: auth, 'Content-Type': 'application/json' },
+      body: JSON.stringify(data),
+    })
+    const crop = { ratio: '1:1', x: 0.05, y: 0.2, width: 0.75, height: 0.5 }
+    const cropUrl = base + '/session-card-crop'
+    expect((await patch(base, { cover_photo_id: photoId })).status).toBe(200)
+    expect((await patch(cropUrl, { photo_id: photoId, crop }, '')).status).toBe(401)
+    expect((await patch(cropUrl, { photo_id: photoId, crop: { ...crop, x: 0.5 } })).status).toBe(400)
+    const saved = await Promise.all([
+      patch(base, { session_model: { name: '카드 테스트' } }),
+      patch(cropUrl, { photo_id: photoId, crop }),
+    ])
+    expect(saved.map((response) => response.status)).toEqual([200, 200])
+    const detail = await (await SELF.fetch(base)).json()
+    expect(detail.session_model.name).toBe('카드 테스트')
+    expect(detail.session_card_crop).toEqual({ photo_id: photoId, ...crop })
+    const getCard = async () => {
+      const list = await (await SELF.fetch('https://example.com/api/collections')).json()
+      return list.find((collection) => collection.id === id)
+    }
+    expect((await getCard()).session_card_crop).toEqual(detail.session_card_crop)
+    expect((await patch(cropUrl, { photo_id: photoId, crop: null })).status).toBe(200)
+    expect((await getCard()).session_card_crop).toBeNull()
+    expect((await patch(cropUrl, { photo_id: photoId, crop })).status).toBe(200)
+    expect((await patch(base, { cover_photo_id: second.meta.last_row_id })).status).toBe(200)
+    expect((await getCard()).session_card_crop).toBeNull()
+    expect((await patch(cropUrl, { photo_id: photoId, crop })).status).toBe(409)
+  })
+})
