+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { runInNewContext } from 'node:vm'
+import { test } from 'node:test'
+
+const identityFunctions = readFileSync(new URL('../public/session-card.js', import.meta.url), 'utf8')
+const { sessionSubtitle, sessionCardHtml } = runInNewContext(
+  `${identityFunctions}\n({ sessionSubtitle, sessionCardHtml })`, { esc: String }
+)
+
+test('session subtitles remove only an exact, delimited series prefix and preserve source metadata', () => {
+  const identity = { series: ['체인소 맨'], character: '체인소 맨 - 레제 & 덴지' }
+  assert.equal(sessionSubtitle(identity), '체인소 맨 · 레제 & 덴지')
+  assert.equal(identity.character, '체인소 맨 - 레제 & 덴지')
+  assert.equal(sessionSubtitle({ series: ['붕괴: 스타레일'], character: '붕괴: 스타레일 — 완·매' }), '붕괴: 스타레일 · 완·매')
+  assert.equal(sessionSubtitle({ series: ['체인소 맨'], character: '체인소 맨션' }), '체인소 맨 · 체인소 맨션')
+  assert.equal(sessionSubtitle({ series: [], character: '체인소 맨 - 레제 & 덴지' }), '체인소 맨 - 레제 & 덴지')
+  assert.equal(sessionSubtitle({ series: ['체인소 맨'], character: '체인소 맨' }), '체인소 맨')
+})
