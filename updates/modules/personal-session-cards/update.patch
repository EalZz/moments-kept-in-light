diff --git a/public/session-card.js b/public/session-card.js
new file mode 100644
index 0000000000000000000000000000000000000000..768b02cfbcc7a11f9d5b2b16b1049e6534679372
--- /dev/null
+++ b/public/session-card.js
@@ -0,0 +1,113 @@
+function sessionList(value, separator = /[,\s]+/) {
+  const values = Array.isArray(value) ? value : String(value || '').split(separator)
+  return values.map((item) => String(item || '').trim()).filter(Boolean)
+}
+function sessionModelValue(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null
+  const handles = sessionList(value.twitter).map((handle) => handle.replace(/^@/, ''))
+  const memberNames = value.member_names && typeof value.member_names === 'object' && !Array.isArray(value.member_names)
+    ? Object.fromEntries(Object.entries(value.member_names).map(([handle, name]) => [
+      String(handle).trim().replace(/^@/, '').toLowerCase(),
+      String(name || '').trim(),
+    ]))
+    : {}
+  const names = handles.map((handle) => memberNames[handle.toLowerCase()] || '')
+  const name = names.length && names.every(Boolean) ? names.join(' & ') : String(value.name || '').trim()
+  const model = {
+    name,
+    handles,
+    character: String(value.character || '').trim(),
+    series: sessionList(value.series, /[,\n]+/),
+  }
+  return model.name || model.handles.length || model.character || model.series.length ? model : null
+}
+function sessionTitleFallback(title) {
+  const parts = String(title || '').split(/\s+[-–—]\s+/)
+  if (parts.length < 2) return { name: String(title || '').trim(), handles: [], character: '', series: [] }
+  return {
+    name: parts.shift().trim(),
+    handles: [],
+    character: parts.join(' - ').trim(),
+    series: [],
+  }
+}
+function sessionIdentityOf(title, sections = [], collectionModel = null) {
+  const direct = sessionModelValue(collectionModel)
+  if (direct) return direct
+  const legacy = sections.find((section) => section.name || section.character || section.handles?.length)
+  if (legacy) {
+    return {
+      name: sessionList(legacy.modelNames).join(' & ') || String(legacy.name || '').trim(),
+      handles: sessionList(legacy.handles),
+      character: String(legacy.character || '').trim(),
+      series: sessionList(legacy.series, /[,\n]+/),
+    }
+  }
+  return sessionTitleFallback(title)
+}
+function sessionSubtitleParts(identity) {
+  const series = sessionList(identity?.series, /[,\n]+/)
+  let character = String(identity?.character || '').trim()
+  // 화면 표시만 정리합니다. 캐릭터 필드에 포함된 작품명은 경계가 명확할 때만 생략합니다.
+  for (const title of [...series].sort((a, b) => b.length - a.length)) {
+    if (character === title) { character = ''; break }
+    if (!character.startsWith(title)) continue
+    const rest = character.slice(title.length)
+    if (/^\s*[-–—:·]\s*/.test(rest)) {
+      character = rest.replace(/^\s*[-–—:·]\s*/, '').trim()
+      break
+    }
+  }
+  return { series: series.join(', '), character }
+}
+function sessionSubtitle(identity) {
+  const { series, character } = sessionSubtitleParts(identity)
+  return [series, character].filter(Boolean).join(' · ')
+}
+
+// 영역 좌표는 원본 사진의 너비와 높이에 대한 비율입니다.
+function sessionCardCropStyle(crop) {
+  if (!crop) return ''
+  return `--crop-width:${100 / crop.width}%;--crop-height:${100 / crop.height}%;--crop-left:${-100 * crop.x / crop.width}%;--crop-top:${-100 * crop.y / crop.height}%`
+}
+
+function sessionCardMediaStyle(crop, sourceRatio) {
+  const fullRatio = Number.isFinite(sourceRatio) && sourceRatio > 0 ? Math.min(1, sourceRatio) : 0.8
+  const ratio = crop ? (crop.ratio === '4:5' ? 0.8 : 1) : fullRatio
+  return `--session-photo-ratio:${ratio}`
+}
+
+function sessionCardHtml(collection, { key, width, height, crop, href } = {}) {
+  const identity = sessionIdentityOf(collection.title, [], collection.session_model)
+  const title = identity.name || collection.title
+  const { series, character } = sessionSubtitleParts(identity)
+  const location = ({ venue: 'Event venue', outdoor: 'Outdoor', studio: 'Studio' })[collection.location_type]
+  const info = [location, `${collection.photo_count} photos`].filter(Boolean).join(' · ')
+  const src = `/img/${esc(key)}`
+  const tag = href ? 'a' : 'div'
+  const loading = href ? ' loading="lazy"' : ''
+  return `
+    <${tag} class="session-card"${href ? ` href="${esc(href)}"` : ''} style="${sessionCardMediaStyle(crop, width / height)}">
+      <img class="session-card-ambient" src="${src}" alt=""${loading} />
+      <div class="session-card-photo${crop ? ' has-crop' : ''}">
+        <img src="${src}" alt="" style="${sessionCardCropStyle(crop)}"${loading} />
+      </div>
+      <div class="session-card-text">
+        <div class="session-card-name-slot">
+          <div class="session-card-name" title="${esc(title)}">${esc(title)}</div>
+        </div>
+        ${series || character ? `<div class="session-card-subtitle">
+          ${series ? `<div class="session-card-series" title="${esc(series)}">${esc(series)}</div>` : ''}
+          ${character ? `<div class="session-card-character" title="${esc(character)}">${esc(character)}</div>` : ''}
+        </div>` : ''}
+        <div class="session-card-info">${esc(info)}</div>
+      </div>
+    </${tag}>`
+}
+
+function updateSessionCardCrop(card, crop, sourceRatio) {
+  card.style.cssText = sessionCardMediaStyle(crop, sourceRatio)
+  const photo = card.querySelector('.session-card-photo')
+  photo.classList.toggle('has-crop', Boolean(crop))
+  photo.firstElementChild.style.cssText = sessionCardCropStyle(crop)
+}
