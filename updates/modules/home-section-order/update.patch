+function setupHomeSectionOrder() {
+  const list = document.getElementById('homeSectionOrder')
+  const save = document.getElementById('homeSectionOrderSave')
+  const status = document.getElementById('homeOrderStatus')
+  const serialize = () => Array.from(list.children, (row) => row.dataset.kind).join(',')
+  let savedOrder = serialize()
+  let drag = null
+  let saving = false
+  function syncSave() {
+    save.disabled = saving || Boolean(drag) || serialize() === savedOrder
+  }
+
+  list.addEventListener('pointerdown', (event) => {
+    const row = event.target.closest('.home-order-row')?.parentElement
+    if (!row || saving || drag || event.button !== 0 || !event.isPrimary) return
+    drag = { row, id: event.pointerId, before: row.nextElementSibling }
+    row.classList.add('is-dragging')
+    list.setPointerCapture(event.pointerId)
+    syncSave()
+  })
+  list.addEventListener('pointermove', (event) => {
+    if (drag?.id !== event.pointerId) return
+    const next = Array.from(list.children).find((row) => {
+      if (row === drag.row) return false
+      const rect = row.getBoundingClientRect()
+      return event.clientY < rect.top + rect.height / 2
+    }) || null
+    if (next !== drag.row.nextElementSibling) {
+      list.insertBefore(drag.row, next)
+      status.textContent = ''
+    }
+  })
+  function finishDrag(event) {
+    if (drag?.id !== event.pointerId) return
+    if (event.type === 'pointercancel') list.insertBefore(drag.row, drag.before)
+    drag.row.classList.remove('is-dragging')
+    drag = null
+    syncSave()
+  }
+  list.addEventListener('pointerup', finishDrag)
+  list.addEventListener('pointercancel', finishDrag)
+  list.addEventListener('lostpointercapture', (event) => {
+    if (event.target === list) finishDrag(event)
+  })
+  list.addEventListener('keydown', (event) => {
+    const button = event.target.closest('.home-order-row')
+    if (!button || saving || drag || !['ArrowUp', 'ArrowDown'].includes(event.key)) return
+    const row = button.parentElement
+    const up = event.key === 'ArrowUp'
+    const neighbor = up ? row.previousElementSibling : row.nextElementSibling
+    event.preventDefault()
+    if (!neighbor) return
+    list.insertBefore(row, up ? neighbor : neighbor.nextElementSibling)
+    button.focus({ preventScroll: true })
+    const position = Array.from(list.children).indexOf(row) + 1
+    status.textContent = `${HOME_SECTION_LABELS[row.dataset.kind]} · ${position}번째`
+    syncSave()
+  })
+  save.addEventListener('click', async () => {
+    if (saving || drag) return
+    const order = serialize()
+    saving = true
+    syncSave()
+    status.textContent = '저장 중…'
+    try {
+      await api('/settings', { method: 'PATCH', json: { home_section_order: order } })
+      savedOrder = order
+      status.textContent = '저장됨'
+    } catch (error) {
+      status.textContent = '저장 실패: ' + error.message
+    } finally {
+      saving = false
+      syncSave()
+    }
+  })
+}
+
