diff --git a/test/home-section-order.worker.test.js b/test/home-section-order.worker.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..4450e75d531d8f32840d951a7667b7672943c4b2
--- /dev/null
+++ b/test/home-section-order.worker.test.js
@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest'
+import { env, SELF } from 'cloudflare:test'
+
+async function login(password = 'test-password') {
+  const response = await SELF.fetch('https://example.com/api/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ password }),
+  })
+  return { response, cookie: response.headers.get('set-cookie')?.split(';')[0] }
+}
+
+async function seedCollection({ title, published = 1, deletedAt = null, shootType = 'event', locationType = '', relatedEventId = null } = {}) {
+  const result = await env.DB.prepare(
+    `INSERT INTO collections
+       (title, description, published, deleted_at, shoot_type, location_type, related_event_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  ).bind(title || 'Collection', 'Description', published, deletedAt, shootType, locationType, relatedEventId).run()
+  return result.meta.last_row_id
+}
+
+describe('home-section-order', () => {
+  it('stores and validates the home section order', async () => {
+    expect(await (await SELF.fetch('https://example.com/api/settings')).json()).toMatchObject({
+      home_section_order: 'events_first',
+    })
+    expect((await SELF.fetch('https://example.com/api/settings', {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ home_section_order: 'sessions_first' }),
+    })).status).toBe(401)
+    const { cookie } = await login()
+    expect((await SELF.fetch('https://example.com/api/settings', {
+      method: 'PATCH',
+      headers: { Cookie: cookie, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ home_section_order: 'invalid' }),
+    })).status).toBe(400)
+    expect((await SELF.fetch('https://example.com/api/settings', {
+      method: 'PATCH',
+      headers: { Cookie: cookie, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ home_section_order: 'sessions_first' }),
+    })).status).toBe(200)
+    expect(await (await SELF.fetch('https://example.com/api/settings')).json()).toMatchObject({
+      home_section_order: 'sessions_first',
+    })
+    const saveOrder = (home_section_order) => SELF.fetch('https://example.com/api/settings', {
+      method: 'PATCH',
+      headers: { Cookie: cookie, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ home_section_order }),
+    })
+    const order = 'photo_zone,event,session'
+    expect((await saveOrder(order)).status).toBe(200)
+    expect((await saveOrder('photo_zone,event,event')).status).toBe(400)
+    const saved = await SELF.fetch('https://example.com/api/settings', { headers: { Cookie: cookie } })
+    expect(saved.headers.get('Cache-Control')).toBe('private, no-store')
+    expect(await saved.json()).toMatchObject({ home_section_order: order })
+  })
+})
