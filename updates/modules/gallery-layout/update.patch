+test('mobile odd sets fill the first row without cropping and preserve lightbox order', () => {
+  for (const width of [280, 319, 390, 640]) {
+    for (const count of [1, 3, 5, 7]) {
+      for (const ratio of [2 / 3, 0.75, 1.5, 8]) {
+        const items = photos(Array(count).fill(2 / 3))
+        items[0] = { ...photos([ratio])[0], key_medium: 'lead-medium' }
+        const html = justifiedHtml(items, 17, width, 8, true, true)
+        const height = +html.match(/height:([\d.]+)px/)[1]
+        const tileWidth = +html.match(/style="width:([\d.]+)px"/)[1]
+        assert.ok(Math.abs(tileWidth - width) < 1e-8)
+        assert.ok(Math.abs(tileWidth / height - ratio) < 1e-8)
+        assert.ok(html.includes('src="/img/lead-medium"'))
+        assert.deepEqual([...html.matchAll(/data-i="(\d+)"/g)].map((m) => +m[1]), items.map((_, i) => i + 17))
+        if (width === 319) {
+          const counts = html.split('<div class="jrow').slice(1).map((row) => [...row.matchAll(/data-i=/g)].length)
+          assert.deepEqual(counts, [1, ...Array((count - 1) / 2).fill(2)])
+        }
+      }
+    }
+  }
+  // PC는 컨테이너가 좁아도 기존 행 높이를 유지합니다.
