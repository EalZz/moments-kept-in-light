-        <img src="/img/${esc(p.key_thumb)}" alt="${esc(photoAltText(p))}" loading="lazy" data-fade />
+        <img src="/img/${esc(sparse || (mobile && end - start === 1) ? p.key_medium || p.key_large || p.key_thumb : p.key_thumb)}" alt="${esc(photoAltText(p))}" loading="lazy" data-fade />
       </button>`).join('')}</div>`
   }).join('')
 }
