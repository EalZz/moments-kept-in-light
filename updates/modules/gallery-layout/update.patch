+function mobileRows(photos, containerW, gap) {
+  if (!photos.length || containerW <= 0) return []
+  const rows = []
+  const ratios = photos.map(aspectOf)
+  for (let start = 0; start < photos.length;) {
+    if (ratios[start] >= 1) {
+      rows.push({ start, end: start + 1, height: containerW / ratios[start] })
+      start++
+      continue
+    }
+    let runEnd = start + 1
+    while (runEnd < photos.length && ratios[runEnd] < 1) runEnd++
+    // 세로 사진 묶음이 홀수면 첫 장을 강조하고 나머지를 두 장씩 배치합니다.
+    if ((runEnd - start) % 2) {
+      rows.push({ start, end: start + 1, height: containerW / ratios[start] })
+      start++
+    }
+    for (; start < runEnd; start += 2) {
+      rows.push({ start, end: start + 2, height: (containerW - gap) / (ratios[start] + ratios[start + 1]) })
+    }
+  }
+  return rows
+}
+
+function justifiedHtml(photos, offset, containerW, gap, centerSparse = false, mobile = containerW <= 640) {
+  const sparse = !mobile && centerSparse && photos.length > 0 && photos.length <= 2 && containerW > 0
+  const rows = mobile
+    ? mobileRows(photos, containerW, gap)
+    : sparse
+    ? [{ start: 0, end: photos.length, height: Math.min(containerW < 640 ? 240 : 460,
+      (containerW - gap * (photos.length - 1)) / photos.reduce((sum, p) => sum + aspectOf(p), 0)) }]
+    : justifiedRows(photos, containerW, gap)
+  return rows.map(({ start, end, height }) => {
+    return `<div class="jrow${sparse ? ' jrow--centered' : ''}" style="height:${height}px;gap:${gap}px">${photos.slice(start, end).map((p, i) => `
