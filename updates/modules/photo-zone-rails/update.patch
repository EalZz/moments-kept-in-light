+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { runInNewContext } from 'node:vm'
+import { test } from 'node:test'
+
+const railSource = readFileSync(new URL('../public/session-rail.js', import.meta.url), 'utf8')
+const { sessionRailIndex, sessionRailModulo } = runInNewContext(`${railSource}\n({ sessionRailIndex, sessionRailModulo })`)
+
+test('the session rail wraps in both directions and keeps fractional positions', () => {
+  assert.equal(sessionRailIndex(150, 300), 0)
+  assert.equal(sessionRailIndex(151, 300), 1)
+  assert.equal(sessionRailModulo(sessionRailIndex(1200, 300), 4), 0)
+  assert.equal(sessionRailModulo(sessionRailIndex(-300, 300), 4), 3)
+  assert.equal(sessionRailModulo(1200.25, 1200), 0.25)
+  assert.equal(sessionRailModulo(-0.5, 1200), 1199.5)
+})
