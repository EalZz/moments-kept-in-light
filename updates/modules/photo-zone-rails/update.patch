+
+async function login(password = 'test-password') {
+  const response = await SELF.fetch('https://example.com/api/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ password }),
+  })
+  return { response, cookie: response.headers.get('set-cookie')?.split(';')[0] }
+}
+
+async function seedCollection({ title, published = 1, deletedAt = null, shootType = 'event', locationType = '', relatedEventId = null } = {}) {
+  const result = await env.DB.prepare(
+    `INSERT INTO collections
+       (title, description, published, deleted_at, shoot_type, location_type, related_event_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  ).bind(title || 'Collection', 'Description', published, deletedAt, shootType, locationType, relatedEventId).run()
+  return result.meta.last_row_id
+}
+
+describe('photo-zone-rails', () => {
+  it('classifies Photo Zone as a session and lists only public, non-empty linked shoots for an event', async () => {
+    const eventId = await seedCollection({ title: 'Event' })
+    const personalId = await seedCollection({ title: 'Personal', shootType: 'session', relatedEventId: eventId })
+    const { cookie } = await login()
+    const headers = { Cookie: cookie, 'Content-Type': 'application/json' }
+    const create = (title, shootType = 'session') => SELF.fetch('https://example.com/api/collections', {
+      method: 'POST', headers,
+      body: JSON.stringify({
+        title, shoot_type: shootType, session_kind: 'photo_zone',
+        related_event_id: shootType === 'session' ? eventId : null, session_model: { name: title },
+      }),
+    })
+    expect((await create('Invalid', 'event')).status).toBe(400)
+    const id = (await (await create('Zone')).json()).id
+    const emptyId = (await (await create('Empty')).json()).id
+    const draftId = (await (await create('Draft')).json()).id
+    const details = async (collectionId) =>
+      (await SELF.fetch(`https://example.com/api/collections/${collectionId}`)).json()
+    const patch = (collectionId, json) => SELF.fetch(`https://example.com/api/collections/${collectionId}`, {
+      method: 'PATCH', headers, body: JSON.stringify(json),
+    })
+    for (const collectionId of [id, draftId, personalId]) {
+      await env.DB.prepare('INSERT INTO photos (collection_id, key_thumb, key_large) VALUES (?, ?, ?)')
+        .bind(collectionId, 'thumb-' + collectionId, 'large-' + collectionId).run()
+    }
+    expect((await patch(id, { published: true, session_kind: 'photo_zone', session_model: { name: 'Renamed' } })).status).toBe(200)
+    expect((await patch(emptyId, { published: true })).status).toBe(200)
+    expect((await details(id)).session_model.name).toBe('Renamed')
+    expect((await details(personalId)).session_kind).toBe('personal')
+    expect((await details(eventId)).related_photo_zones).toEqual([{ id, title: 'Zone' }])
+    const list = await (await SELF.fetch('https://example.com/api/collections')).json()
+    expect(list.find((collection) => collection.id === id).session_kind).toBe('photo_zone')
+    expect((await patch(id, { session_kind: 'personal' })).status).toBe(200)
+    expect((await details(id)).session_kind).toBe('personal')
+    expect((await details(eventId)).related_photo_zones).toEqual([])
+  })
+})
