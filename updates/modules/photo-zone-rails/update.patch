diff --git a/public/session-rail.js b/public/session-rail.js
new file mode 100644
index 0000000000000000000000000000000000000000..3f9a53eaf64f6711ace99b5fa52e401f29b95e47
--- /dev/null
+++ b/public/session-rail.js
@@ -0,0 +1,246 @@
+function sessionRailModulo(position, cycle) {
+  return ((position % cycle) + cycle) % cycle
+}
+
+function sessionRailIndex(position, step) {
+  return Math.round(position / step - 0.001)
+}
+
+function mountSessionRails(elements) {
+  const rails = Array.from(elements)
+  if (!rails.length) return null
+  const controller = new AbortController()
+  const { signal } = controller
+  const mobile = matchMedia('(max-width: 620px)')
+  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
+  let frame = 0
+  let lastFrame = 0
+  let viewportWidth = document.body.clientWidth
+
+  const states = rails.map((rail) => {
+    const cards = Array.from(rail.children)
+    const section = rail.parentElement
+    const track = document.createElement('div')
+    track.className = 'session-rail-track'
+    track.append(...cards)
+    rail.append(track)
+    const state = {
+      rail, track, cards, section, overflow: false, hovered: false, gesture: null,
+      inView: false, position: 0, center: 0, step: 1, snap: null,
+      wheelAt: -Infinity, suppressClickUntil: 0, copies: [],
+    }
+
+    function snap(index, immediate = false) {
+      const target = index * state.step
+      if (immediate || reducedMotion.matches) {
+        state.snap = null
+        state.position = sessionRailModulo(target, state.step * cards.length)
+        paint(state)
+      } else {
+        state.snap = { from: state.position, to: target, start: performance.now() }
+        queueAnimation()
+      }
+    }
+    function currentIndex() {
+      return sessionRailIndex(state.snap?.to ?? state.position, state.step)
+    }
+
+    rail.addEventListener('pointerenter', (event) => {
+      if (event.pointerType === 'mouse') state.hovered = true
+    }, { signal })
+    rail.addEventListener('pointerleave', (event) => {
+      if (event.pointerType === 'mouse') state.hovered = false
+    }, { signal })
+    rail.addEventListener('wheel', (event) => {
+      if (!state.overflow || !state.hovered || event.ctrlKey || !event.cancelable) return
+      const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY
+      if (!delta) return
+      const now = performance.now()
+      if (now - state.wheelAt > 150) snap(currentIndex() + Math.sign(delta))
+      state.wheelAt = now
+      event.preventDefault()
+    }, { signal, passive: false })
+
+    rail.addEventListener('pointerdown', (event) => {
+      if (event.pointerType === 'mouse' || !state.overflow || state.gesture || !event.isPrimary) return
+      state.snap = null
+      state.gesture = {
+        id: event.pointerId, x: event.clientX, y: event.clientY,
+        start: state.position, index: currentIndex(), dragging: false,
+      }
+    }, { signal })
+    rail.addEventListener('pointermove', (event) => {
+      const gesture = state.gesture
+      if (gesture?.id !== event.pointerId) return
+      const dx = event.clientX - gesture.x
+      const dy = event.clientY - gesture.y
+      if (!gesture.dragging && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
+        gesture.dragging = true
+        rail.setPointerCapture(event.pointerId)
+      }
+      if (gesture.dragging) {
+        state.position = gesture.start - dx
+        paint(state)
+      }
+    }, { signal })
+    function finishGesture(event) {
+      const gesture = state.gesture
+      if (gesture?.id !== event.pointerId) return
+      state.gesture = null
+      if (!gesture.dragging) return
+      const dx = event.clientX - gesture.x
+      const moveThreshold = Math.min(42, state.step * 0.15)
+      const direction = event.type === 'pointerup' && Math.abs(dx) >= moveThreshold ? -Math.sign(dx) : 0
+      state.suppressClickUntil = performance.now() + 500
+      snap(gesture.index + direction)
+    }
+    rail.addEventListener('pointerup', finishGesture, { signal })
+    rail.addEventListener('pointercancel', finishGesture, { signal })
+    rail.addEventListener('lostpointercapture', (event) => {
+      if (event.target === rail) finishGesture(event)
+    }, { signal })
+    rail.addEventListener('click', (event) => {
+      if (event.detail && performance.now() < state.suppressClickUntil) {
+        event.preventDefault()
+        event.stopPropagation()
+      }
+    }, { signal, capture: true })
+
+    rail.addEventListener('keydown', (event) => {
+      if (!state.overflow || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return
+      event.preventDefault()
+      const index = currentIndex() + (event.key === 'ArrowLeft' ? -1 : 1)
+      snap(index)
+      cards[sessionRailModulo(index, cards.length)].focus({ preventScroll: true })
+    }, { signal })
+    rail.addEventListener('focusin', (event) => {
+      if (!state.overflow || !event.target.matches(':focus-visible')) return
+      const index = cards.indexOf(event.target)
+      if (index < 0) return
+      const current = currentIndex()
+      if (state.snap && sessionRailModulo(current, cards.length) === index) return
+      snap(index + Math.round((current - index) / cards.length) * cards.length, true)
+    }, { signal })
+    return state
+  })
+
+  function paint(state) {
+    const cycle = state.cards.length * state.step
+    const offset = state.center - cycle - sessionRailModulo(state.position, cycle)
+    state.track.style.transform = `translate3d(${offset}px, 0, 0)`
+  }
+
+  function layout(state) {
+    const { rail, track, section, cards } = state
+    const contentWidth = section.clientWidth
+    if (!contentWidth) return
+    const wasOverflowing = state.overflow
+    const position = state.position / state.step
+    state.overflow = cards.length > (mobile.matches ? 1 : 2)
+    rail.classList.toggle('is-scrollable', state.overflow)
+    rail.style.setProperty('--rail-content-width', contentWidth + 'px')
+    const margin = Math.max(0, (viewportWidth - contentWidth) / 2)
+    rail.style.setProperty('--rail-margin', margin + 'px')
+    rail.style.setProperty('--rail-width', viewportWidth + 'px')
+    state.snap = null
+    state.gesture = null
+    if (!state.overflow) {
+      for (const copy of state.copies) copy.remove()
+      state.copies = []
+      track.style.removeProperty('transform')
+      return
+    }
+    if (!wasOverflowing) {
+      // 앞뒤로 같은 순서를 배치해 주기가 바뀌는 순간에도 화면이 이어집니다.
+      const copyCards = () => cards.map((card) => {
+        const copy = card.cloneNode(true)
+        copy.setAttribute('aria-hidden', 'true')
+        copy.tabIndex = -1
+        return copy
+      })
+      const before = copyCards()
+      const after = copyCards()
+      state.copies = [...before, ...after]
+      track.prepend(...before)
+      track.append(...after)
+    }
+    const first = cards[0].getBoundingClientRect()
+    state.step = cards[1].getBoundingClientRect().left - first.left || 1
+    state.center = (rail.clientWidth - first.width) / 2
+    state.position = wasOverflowing ? position * state.step : state.center - margin
+    paint(state)
+  }
+
+  const resize = new ResizeObserver((entries) => {
+    const width = document.body.clientWidth
+    if (width !== viewportWidth) {
+      viewportWidth = width
+      states.forEach(layout)
+    } else {
+      for (const state of states) {
+        if (entries.some((entry) => entry.target === state.section)) layout(state)
+      }
+    }
+    queueAnimation()
+  })
+  resize.observe(document.body)
+  const visibility = new IntersectionObserver((entries) => {
+    for (const entry of entries) states.find((state) => state.rail === entry.target).inView = entry.isIntersecting
+    queueAnimation()
+  })
+  for (const state of states) {
+    layout(state)
+    resize.observe(state.section)
+    visibility.observe(state.rail)
+  }
+  window.addEventListener('resize', () => {
+    viewportWidth = document.body.clientWidth
+    states.forEach(layout)
+    queueAnimation()
+  }, { signal })
+
+  function queueAnimation() {
+    if (!frame && states.some((state) => state.inView && state.overflow)) {
+      lastFrame = 0
+      frame = requestAnimationFrame(tick)
+    }
+  }
+  function tick(now) {
+    frame = 0
+    const visible = states.filter((state) => state.inView && state.overflow)
+    if (!visible.length) return
+    const elapsed = Math.min(40, now - (lastFrame || now))
+    lastFrame = now
+    const snapping = visible.some((state) => state.snap)
+    let active = null
+    let distance = Infinity
+    for (const state of visible) {
+      if (state.snap) {
+        const progress = Math.max(0, Math.min(1, (now - state.snap.start) / 380))
+        const ease = 1 - (1 - progress) ** 3
+        state.position = state.snap.from + (state.snap.to - state.snap.from) * ease
+        if (progress === 1) {
+          state.snap = null
+          state.position = sessionRailModulo(state.position, state.step * state.cards.length)
+        }
+        paint(state)
+        continue
+      }
+      const { top, height } = state.rail.getBoundingClientRect()
+      const fromCenter = Math.abs(top + height / 2 - innerHeight / 2)
+      if (fromCenter < distance) { active = state; distance = fromCenter }
+    }
+    if (active && !snapping && !active.hovered && !active.gesture && !document.hidden && !reducedMotion.matches &&
+        !document.body.classList.contains('intro-on') && !active.rail.querySelector(':focus-visible')) {
+      active.position = sessionRailModulo(active.position + elapsed * 0.022, active.step * active.cards.length)
+      paint(active)
+    }
+    frame = requestAnimationFrame(tick)
+  }
+  return () => {
+    controller.abort()
+    resize.disconnect()
+    visibility.disconnect()
+    cancelAnimationFrame(frame)
+  }
+}
