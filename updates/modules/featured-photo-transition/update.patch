+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { runInNewContext } from 'node:vm'
+import { test } from 'node:test'
+
+const source = readFileSync(new URL('../public/app.js', import.meta.url), 'utf8')
+const functions = source.slice(source.indexOf('function createFeatureTransition('), source.indexOf('// 컬렉션 카드 HTML'))
+const flush = async () => { for (let i = 0; i < 12; i++) await Promise.resolve() }
+
+test('ambient waits for the sharp photo and crossfades to the same source without accumulating layers', async () => {
+  const f = fixture({ withAmbient: true, desktop: true })
+  f.start()
+  for (const key of ['2', '3']) {
+    f.swipe()
+    const incoming = f.requested.at(-1)
+    const previous = f.ambient.images[0].src
+    await f.advance(1000)
+    assert.deepEqual(f.ambient.images.map((image) => image.src), [previous])
+    incoming.ready()
+    await flush()
+    assert.deepEqual(f.ambient.images.map((image) => image.src), [previous, '/img/' + key])
+    assert.equal(f.ambient.images[0].style.opacity, '0')
+    assert.equal(f.ambient.images[1].style.opacity, '1')
+    assert.equal(f.ambient.images[1].alt, '')
+    assert.equal(f.fields['.name'].textContent, key)
+    incoming.endTransition()
+    await flush()
+    assert.deepEqual(f.ambient.images.map((image) => image.src), ['/img/' + key])
+    assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/' + key])
+  }
+  assert.deepEqual(f.animations.map(([part]) => part), ['heading', 'details', 'heading', 'details'])
+})
+
+test('failed or timed-out photos leave the existing ambient image in place', async () => {
+  const f = fixture({ withAmbient: true })
+  f.start()
+  f.swipe()
+  f.requested[0].fail()
+  await flush()
+  assert.deepEqual(f.ambient.images.map((image) => image.src), ['/img/1'])
+  f.swipe()
+  await f.advance(15000)
+  assert.deepEqual(f.ambient.images.map((image) => image.src), ['/img/1'])
+  assert.equal(f.animations.length, 0)
+})
+
+test('mobile keeps the original single caption fade', async () => {
+  const f = fixture({ withAmbient: true })
+  f.start()
+  f.swipe()
+  f.requested[0].ready()
+  await flush()
+  assert.deepEqual(f.animations.map(([part]) => part), ['mobile'])
+  assert.equal(f.animations[0][1][0].transform, undefined)
+})
+
+test('fixed collection rotation updates the ambient with the sharp photo', async () => {
+  const f = fixture({ withAmbient: true })
+  await f.startFixed()
+  await f.advance(5000)
+  f.requested[0].ready()
+  await flush()
+  await f.advance(1600)
+  assert.deepEqual(f.ambient.images.map((image) => image.src), ['/img/2'])
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/2'])
+})
+
+function fixture({ decode = true, withAmbient = false, desktop = false } = {}) {
+  let now = 0, nextTimer = 0, attached = true
+  let timers = []
+  const requested = []
+  const schedule = (fn, delay, interval = 0) => {
+    const timer = { id: ++nextTimer, fn, at: now + delay, interval }
+    timers.push(timer)
+    return timer.id
+  }
+  const clear = (id) => { timers = timers.filter((timer) => timer.id !== id) }
+  const advance = async (delay) => {
+    const end = now + delay
+    for (;;) {
+      timers.sort((a, b) => a.at - b.at || a.id - b.id)
+      const timer = timers[0]
+      if (!timer || timer.at > end) break
+      timers.shift()
+      now = timer.at
+      timer.fn()
+      await flush()
+      if (timer.interval && !timers.some((entry) => entry.id === timer.id)) {
+        // callbacks can replace their own interval; the stored ID must still be current.
+        if (context.featureTimer === timer.id) timers.push({ ...timer, at: now + timer.interval })
+      }
+    }
+    now = end
+    await flush()
+  }
+  class Img {
+    constructor() {
+      this.style = { opacity: '' }
+      this.alt = '1'
+      this.listeners = new Map()
+      this.complete = false
+      this.naturalWidth = 0
+      if (!decode) this.decode = undefined
+    }
+    set src(value) {
+      this._src = value
+      requested.push(this)
+    }
+    get src() { return this._src }
+    decode() { return new Promise((resolve, reject) => { this.resolve = resolve; this.reject = reject }) }
+    ready() {
+      this.complete = true
+      this.naturalWidth = 853
+      if (this.resolve) this.resolve()
+      else this.onload?.()
+    }
+    fail() { if (this.reject) this.reject(new Error('Image failed')); else this.onerror?.() }
+    removeAttribute(name) { if (name === 'src') this._src = '' }
+    addEventListener(type, fn) { this.listeners.set(type, fn) }
+    removeEventListener(type, fn) { if (this.listeners.get(type) === fn) this.listeners.delete(type) }
+    cloneNode() {
+      const clone = new Img()
+      clone._src = this.src
+      clone.style.opacity = this.style.opacity
+      clone.complete = this.complete
+      clone.naturalWidth = this.naturalWidth
+      return clone
+    }
+    remove() {
+      holder.images = holder.images.filter((image) => image !== this)
+      ambient.images = ambient.images.filter((image) => image !== this)
+    }
+    get offsetWidth() { return 320 }
+    endTransition() { this.listeners.get('transitionend')?.({ target: this, propertyName: 'opacity' }) }
+  }
+  const original = new Img()
+  original._src = '/img/1'
+  original.complete = true
+  original.naturalWidth = 853
+  const ambient = {
+    images: [original.cloneNode()],
+    querySelector: () => ambient.images[0],
+    appendChild: (image) => ambient.images.push(image),
+  }
+  const holder = {
+    parentElement: { querySelector: () => withAmbient ? ambient : null },
+    images: [original],
+    querySelector: () => holder.images[0],
+    appendChild(image) {
+      assert.ok(image.complete && image.naturalWidth, 'only a ready image may enter the visible stage')
+      holder.images.push(image)
+    },
+  }
+  const fields = {
+    '.name': { textContent: '1', classList: { toggle() {} } }, '.models': { innerHTML: 'model-1' },
+    '.character': { textContent: 'character-1' }, '.feature-info': { animate() {} },
+  }
+  const animations = []
+  fields['.feature-info'].animate = (...args) => animations.push(['mobile', ...args])
+  fields['.feature-info'].querySelectorAll = () => ['heading', 'details'].map((part) => ({
+    animate: (...args) => animations.push([part, ...args]),
+  }))
+  const events = new Map()
+  const link = { href: '#1', querySelector: (selector) => fields[selector], addEventListener: (type, fn) => events.set(type, fn) }
+  const deck = [1, 2, 3, 4].map((id) => ({ title: String(id), key_medium: String(id), character: 'character-' + id }))
+  const context = {
+    window: { matchMedia: (query) => ({ matches: desktop && query.includes('761px') }) },
+    document: { querySelector: () => holder, getElementById: () => link, body: { contains: () => attached }, hidden: false },
+    Image: Img, featureTimer: null, setTimeout: schedule, clearTimeout: clear,
+    setInterval: (fn, delay) => schedule(fn, delay, delay), clearInterval: clear,
+    shuffle: (items) => items, featureHref: (photo) => '#' + photo.title,
+    modelCreditHtml: (photo) => 'model-' + photo.title, modelCreditText: (photo) => 'model-' + photo.title,
+    api: async () => ({ photos: deck }),
+  }
+  const { startRandomFeature, startFeatureRotation } = runInNewContext(functions + '\n({startRandomFeature, startFeatureRotation})', context)
+  const swipe = (direction = 1) => {
+    events.get('mousedown')({ clientX: 100, clientY: 100 })
+    events.get('mouseup')({ clientX: direction > 0 ? 0 : 200, clientY: 100 })
+  }
+  return { holder, ambient, animations, requested, fields, link, advance, swipe, start: () => startRandomFeature(deck),
+    startFixed: () => startFeatureRotation(1, '1'), detach: () => { attached = false } }
+}
+
+test('slow loading keeps photo and caption together; 2 → 3 never reintroduces photo 1', async () => {
+  const f = fixture()
+  f.start()
+  f.swipe()
+  await f.advance(2000)
+  assert.equal(f.fields['.name'].textContent, '1')
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/1'])
+  f.requested[0].ready()
+  await flush()
+  assert.equal(f.fields['.name'].textContent, '2')
+  assert.equal(f.link.href, '#2')
+  assert.match(f.requested[0].alt, /model-2/)
+  f.requested[0].endTransition()
+  await flush()
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/2'])
+  f.swipe()
+  await f.advance(2000)
+  assert.equal(f.fields['.name'].textContent, '2')
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/2'])
+  f.requested[1].ready()
+  await flush()
+  assert.equal(f.fields['.name'].textContent, '3')
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/2', '/img/3'])
+  await f.advance(1600)
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/3'])
+})
+
