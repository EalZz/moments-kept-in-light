+  f.swipe()
+  assert.equal(f.requested[1].src, '/img/3')
+  f.requested[1].ready()
+  await flush()
+  assert.equal(f.fields['.name'].textContent, '3')
+})
+
+test('a timeout unlocks navigation without exposing an unfinished or late image', async () => {
+  const f = fixture()
+  f.start()
+  f.swipe()
+  await f.advance(15000)
+  assert.equal(f.fields['.name'].textContent, '1')
+  assert.deepEqual(f.holder.images.map((image) => image.src), ['/img/1'])
+  f.requested[0].ready()
