+function createFeatureTransition(holder) {
+  let front = holder.querySelector('img')
+  const ambient = holder.parentElement?.querySelector('.feature-ambient')
+  let busy = false
+  return async (key, alt, onSwap = () => {}) => {
+    if (busy || !document.body.contains(holder)) return null
+    busy = true
+    const incoming = new Image()
+    let incomingAmbient = null
+    incoming.alt = alt
+    incoming.style.opacity = '0'
+    incoming.fetchPriority = 'high'
+    try {
+      await new Promise((resolve, reject) => {
+        let settled = false
+        const finish = (error) => {
+          if (settled) return
+          settled = true
+          clearTimeout(timeout)
+          incoming.onload = incoming.onerror = null
+          if (error) { incoming.removeAttribute('src'); reject(error) }
+          else resolve()
+        }
+        // 시간 초과 시 현재 사진을 유지합니다. 미완성 사진으로는 전환하지 않습니다.
+        const timeout = setTimeout(() => finish(new Error('Feature image timeout')), 15000)
+        incoming.onerror = () => finish(new Error('Feature image failed'))
+        if (!incoming.decode) incoming.onload = () => finish()
+        incoming.src = '/img/' + key
+        if (incoming.decode) incoming.decode().then(() => finish(), finish)
+      })
+      if (!document.body.contains(holder)) return false
+      const outgoing = front
+      const outgoingAmbient = ambient?.querySelector('img')
+      incomingAmbient = ambient ? incoming.cloneNode() : null
+      if (incomingAmbient) {
+        incomingAmbient.alt = ''
+        incomingAmbient.removeAttribute('fetchpriority')
+        ambient.appendChild(incomingAmbient)
+      }
+      holder.appendChild(incoming)
+      void incoming.offsetWidth // opacity: 0인 초기 상태를 확정한 뒤 페이드합니다.
+      await new Promise((resolve) => {
+        const finish = (event) => {
+          if (event && (event.target !== incoming || event.propertyName !== 'opacity')) return
+          clearTimeout(timeout)
+          incoming.removeEventListener('transitionend', finish)
+          resolve()
+        }
+        const timeout = setTimeout(() => finish(), 1600)
+        incoming.addEventListener('transitionend', finish)
+        onSwap()
+        incoming.style.opacity = '1'
+        outgoing.style.opacity = '0'
+        if (incomingAmbient) incomingAmbient.style.opacity = '1'
+        if (outgoingAmbient) outgoingAmbient.style.opacity = '0'
+      })
+      outgoing.remove()
+      outgoingAmbient?.remove()
+      front = incoming
+      return true
+    } catch {
+      incoming.remove()
+      incomingAmbient?.remove()
+      return false
+    } finally {
+      busy = false
+    }
+  }
+}
